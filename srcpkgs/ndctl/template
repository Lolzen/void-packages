# Template file for 'ndctl'
pkgname=ndctl
version=85
revision=1
build_style=meson
configure_args="-Dversion-tag=${version} -Ddocs=disabled -Dsystemd=disabled
 -Dmodprobedatadir=/usr/lib/modprobe.d
 -Diniparserdir=${XBPS_CROSS_BASE}/usr/include/iniparser"
hostmakedepends="pkg-config"
makedepends="eudev-libudev-devel json-c-devel libkmod-devel libuuid-devel
 bash-completion keyutils-devel iniparser-devel libtraceevent-devel
 libtracefs-devel"
short_desc="Utility library for managing libnvdimm"
maintainer="Orphaned <orphan@voidlinux.org>"
license="LGPL-2.1-only AND GPL-2.0-only AND CC0-1.0 AND MIT"
homepage="https://github.com/pmem/ndctl"
distfiles="https://github.com/pmem/ndctl/archive/v${version}.tar.gz"
checksum=69039ee12c75c44f67b5fa3f1abb61d1c38ff9303021e50cec0b45801cc93b2e
conf_files="/etc/ndctl.conf.d/monitor.conf
 /etc/ndctl.conf.d/ndctl.conf"

case "$XBPS_TARGET_MACHINE" in
	ppc|ppc-musl) broken="broken on ppc" ;;
esac

post_install() {
	vlicense LICENSES/other/MIT
}

libndctl_package() {
	short_desc+=" - ndctl library"
	pkg_install() {
		vmove "usr/lib/libndctl.so.*"
	}
}

libdaxctl_package() {
	short_desc+=" - daxctl library"
	pkg_install() {
		vmove "usr/lib/libdaxctl.so.*"
	}
}

libcxl_package() {
	short_desc+=" - cxl library"
	pkg_install() {
		vmove "usr/lib/libcxl.so.*"
	}
}

libndctl-devel_package() {
	depends="libndctl-${version}_${revision}"
	short_desc+=" - ndctl development files"
	pkg_install() {
		vmove usr/include/ndctl
		vmove usr/lib/pkgconfig/libndctl.pc
		vmove usr/lib/libndctl.so
	}
}

libdaxctl-devel_package() {
	depends="libdaxctl-${version}_${revision}"
	short_desc+=" - daxctl development files"
	pkg_install() {
		vmove usr/include/daxctl
		vmove usr/lib/pkgconfig/libdaxctl.pc
		vmove usr/lib/libdaxctl.so
	}
}

libcxl-devel_package() {
	depends="libcxl-${version}_${revision}"
	short_desc+=" - cxl development files"
	pkg_install() {
		vmove usr/include/cxl
		vmove usr/lib/pkgconfig/libcxl.pc
		vmove usr/lib/libcxl.so
	}
}
